		set xlabel 'exponential quantiles'
		set size ratio 1
		set ylabel 'measured times'
		set key right bottom
		set title 'rl1304_prr_b_restart_200'
		set terminal postscript color 'Helvetica' 
		set output 'rl1304_prr_b_restart_200-qq.ps'
		plot "rl1304_prr_b_restart_200-el.dat" t "empirical" w points, "rl1304_prr_b_restart_200-tl.dat" t "estimated" with lines lt 3, "rl1304_prr_b_restart_200-ul.dat" t "+1 std dev range" w lines lt 4, "rl1304_prr_b_restart_200-ll.dat" t "-1 std dev range" w lines lt 4 
		quit
