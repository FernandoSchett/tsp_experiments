		set xlabel 'time to target solution'
		set size ratio 1
		set ylabel 'cumulative probability'
                set yrange [0:1]
		set key right bottom
                set grid
		set title 'rl1304_prr_b_restart_200'
		set terminal postscript color 'Helvetica'
		set output 'rl1304_prr_b_restart_200-exp.ps'
		plot "rl1304_prr_b_restart_200-ee.dat" t "empirical" w points, "rl1304_prr_b_restart_200-te.dat" t "theoretical" w lines lt 3
		quit
