		set xlabel 'exponential quantiles'
		set size ratio 1
		set ylabel 'measured times'
		set key right bottom
		set title 'u1060_forward'
		set terminal postscript color 'Helvetica' 
		set output 'u1060_forward-qq.ps'
		plot "u1060_forward-el.dat" t "empirical" w points, "u1060_forward-tl.dat" t "estimated" with lines lt 3, "u1060_forward-ul.dat" t "+1 std dev range" w lines lt 4, "u1060_forward-ll.dat" t "-1 std dev range" w lines lt 4 
		quit
