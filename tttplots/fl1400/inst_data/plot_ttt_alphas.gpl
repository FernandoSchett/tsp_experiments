set xlabel 'time to target solution'
set size ratio 1
set ylabel 'cumulative probability'
set yrange [0:1]
set key right bottom
set grid
set title 'fl1400'
set terminal postscript color 'Helvetica'
set output 'fl1400_ttt.ps'
plot "../backward/fl1400_backward-ee.dat" t "backward empirical" w points, "../backward/fl1400_backward-te.dat" t "backward theoretical" w lines lt 3,"../prr_b_restart_100/fl1400_prr_b_restart_100-ee.dat" t "restart-100 empirical" w points, "../prr_b_restart_100/fl1400_prr_b_restart_100-te.dat" t "restart-100 theoretical" w lines lt 3,"../prr_b_restart_200/fl1400_prr_b_restart_200-ee.dat" t "restart-200 empirical" w points, "../prr_b_restart_200/fl1400_prr_b_restart_200-te.dat" t "restart-200 theoretical" w lines lt 3,